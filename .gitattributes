# Normalize line endings. Cross-platform source uses LF; native Windows
# scripts (.bat/.vbs) keep CRLF so Windows interpreters stay happy.
* text=auto eol=lf
*.py   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.spec text eol=lf
*.bat  text eol=crlf
*.vbs  text eol=crlf

# Treat license/image assets sensibly
third_party_licenses/*.txt text eol=lf
*.png binary
*.ico binary
*.woff2 binary

# Front-end sources extracted out of the dashboard (web/)
*.js  text eol=lf
*.css text eol=lf
*.svg text eol=lf
