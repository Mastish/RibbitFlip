              "on": false,
              "ms": 300
            },
            "toast": {
              "on": false,
              "mode": "fire",
              "silent": true,
              "text": ""
            }
          }
        ],
        "mouse": {
          "enabled": true,
          "mode": "stick",
          "padShare": "own",
          "stickBackend": "gamepad",
          "stickWhich": "left",
          "stickSource": "filter",
          "stickMetricX": "roll",
          "stickMetricY": "pitch",
