{
  "app": "ribbitflip",
  "kind": "setup",
  "version": 1,
  "appVersion": "1.0.0",
  "name": "Media - pokrętło głośności",
  "description": "Kapsel leży płasko na biurku i pracuje jak pokrętło: obrót w prawo podgłaśnia, w lewo przycisza, a im szybciej kręcisz, tym szybciej idzie. Kliknięcie przycisku kapsla to start i pauza. Wszystko działa tylko wtedy, gdy kapsel leży płasko, więc podniesiony niczego nie przestawia. Gdyby głośność szła w drugą stronę, zamień klawisze w regułach głośniej i ciszej.",
  "cassette": 7,
  "forApp": "Spotify, YouTube, dowolny odtwarzacz",
  "author": "RibbitFlip",
  "rev": 1,
  "config": {
    "trigEnabled": true,
    "rules": [
      {
        "id": "media-vol-up",
        "label": "Głośniej (obrót w prawo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "twist"},
        "abs": false,
        "cmp": "in",
        "threshold": -130,
        "thresholdHi": -40,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "tilt"}, "abs": false, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 130,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_up",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media-vol-up-fast",
        "label": "Głośniej szybciej (mocny obrót w prawo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "twist"},
        "abs": false,
        "cmp": "<",
        "threshold": -130,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "tilt"}, "abs": false, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 55,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_up",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media-vol-down",
        "label": "Ciszej (obrót w lewo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "twist"},
        "abs": false,
        "cmp": "in",
        "threshold": 40,
        "thresholdHi": 130,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "tilt"}, "abs": false, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 130,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_down",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media-vol-down-fast",
        "label": "Ciszej szybciej (mocny obrót w lewo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "twist"},
        "abs": false,
        "cmp": ">",
        "threshold": 130,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "tilt"}, "abs": false, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 55,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_down",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media-playpause",
        "label": "Start i pauza (kliknięcie przycisku)",
        "enabled": true,
        "source": {"kind": "button", "any": true, "byte": 1, "bit": 0, "holdMs": 250},
        "abs": false,
        "cmp": ">",
        "threshold": 0,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "twist"}, "abs": true, "cmp": "<",
           "threshold": 30, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "once",
        "intervalMs": 100,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_play_pause",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": true, "ms": 250},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      }
    ]
  }
}
