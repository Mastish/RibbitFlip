{
  "app": "ribbitflip",
  "kind": "setup",
  "version": 1,
  "appVersion": "1.0.0",
  "name": "Media - cztery strony",
  "description": "Kapsel w dłoni, cztery strony świata: przechył w prawo to następny utwór, w lewo poprzedni, w tył głośniej, w przód ciszej. Kliknięcie przycisku to start i pauza. Przechył na ukos nie robi nic, więc trudno trafić w dwie akcje naraz. Gdyby któraś para działała odwrotnie, odwróć tę oś w zakładce Czujnik, w wierszu Odwróć kierunek przechyłu.",
  "cassette": 3,
  "forApp": "Spotify, YouTube, dowolny odtwarzacz",
  "author": "RibbitFlip",
  "rev": 1,
  "config": {
    "trigEnabled": true,
    "rules": [
      {
        "id": "media4-next",
        "label": "Następny utwór (przechył w prawo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "roll"},
        "abs": false,
        "cmp": ">",
        "threshold": 30,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "pitch"}, "abs": true, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "once",
        "intervalMs": 100,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_next",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": true, "ms": 200},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media4-prev",
        "label": "Poprzedni utwór (przechył w lewo)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "roll"},
        "abs": false,
        "cmp": "<",
        "threshold": -30,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "pitch"}, "abs": true, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "once",
        "intervalMs": 100,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_previous",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": true, "ms": 200},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media4-vol-up",
        "label": "Głośniej (przechył w tył)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "pitch"},
        "abs": false,
        "cmp": ">",
        "threshold": 30,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "roll"}, "abs": true, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 130,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_up",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media4-vol-down",
        "label": "Ciszej (przechył w przód)",
        "enabled": true,
        "source": {"kind": "filter", "metric": "pitch"},
        "abs": false,
        "cmp": "<",
        "threshold": -30,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "roll"}, "abs": true, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "continuous",
        "intervalMs": 130,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_volume_down",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": false, "ms": 300},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      },
      {
        "id": "media4-playpause",
        "label": "Start i pauza (kliknięcie przycisku)",
        "enabled": true,
        "source": {"kind": "button", "any": true, "byte": 1, "bit": 0, "holdMs": 250},
        "abs": false,
        "cmp": ">",
        "threshold": 0,
        "thresholdHi": null,
        "neg": false,
        "extraConditions": [
          {"source": {"kind": "filter", "metric": "tilt"}, "abs": false, "cmp": "<",
           "threshold": 25, "thresholdHi": null, "op": "and", "neg": false}
        ],
        "match": "all",
        "behavior": "once",
        "intervalMs": 100,
        "dwellMs": 500,
        "crossings": 2,
        "windowMs": 600,
        "layer": 0,
        "keySpec": "media_play_pause",
        "noAction": false,
        "sequence": "",
        "glow": true,
        "led": {"on": true, "ms": 250},
        "toast": {"on": false, "mode": "fire", "silent": true, "text": ""}
      }
    ]
  }
}
